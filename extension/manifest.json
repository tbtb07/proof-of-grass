{
  "manifest_version": 3,
  "name": "Proof of Grass",
  "version": "0.5.0",
  "description": "Proof of Grass browser extension.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://localhost:5050/*"],
  "action": {
    "default_title": "Proof of Grass"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}
